{
  "_meta": {
    "source": "Live observation of HQ Rentals CRM UI during authenticated recon session (2026-10-10). No screenshots captured — measurements estimated from accessibility tree + visual memory.",
    "font_note": "HQ uses a sans-serif (likely Inter or similar). We use Geist (open, Vercel-made, same job).",
    "colour_note": "Brand colour placeholder is neutral blue. replica-brand will replace it before launch.",
    "base": 4
  },

  "color": {
    "roles": {
      "bg":           { "value": "#f8f9fa", "desc": "Page background (light grey wash behind content)" },
      "surface":      { "value": "#ffffff", "desc": "Card, table, panel background" },
      "surface-alt":  { "value": "#f1f3f5", "desc": "Zebra row, hover row, input background" },
      "sidebar-bg":   { "value": "#1a1d23", "desc": "Left sidebar dark background (observed: very dark navy/charcoal)" },
      "sidebar-text": { "value": "#c9cdd4", "desc": "Sidebar nav item text (muted white)" },
      "sidebar-active-bg": { "value": "#2c3040", "desc": "Active sidebar item background" },
      "sidebar-active-text": { "value": "#ffffff", "desc": "Active sidebar item text" },

      "border":       { "value": "#dee2e6", "desc": "Default border (table rows, card edges)" },
      "border-input": { "value": "#767676", "desc": "Input/select border at rest (meets 3:1 on white)" },
      "border-focus": { "value": "#4a90d9", "desc": "Input focus ring colour" },

      "text":         { "value": "#212529", "desc": "Primary body text" },
      "text-muted":   { "value": "#6c757d", "desc": "Secondary/helper text, placeholder" },
      "text-on-dark": { "value": "#ffffff", "desc": "Text on dark/accent backgrounds" },

      "accent":       { "value": "#2563eb", "desc": "Primary action colour (placeholder — replace in branding phase)" },
      "accent-hover": { "value": "#1d4ed8", "desc": "Accent on hover/active" },
      "on-accent":    { "value": "#ffffff", "desc": "Text/icons on accent background" },

      "success":      { "value": "#14532d", "desc": "Confirmed status, paid badge (darkened for AA on success-bg)" },
      "success-bg":   { "value": "#dcfce7", "desc": "Success chip background" },
      "warning":      { "value": "#713f12", "desc": "Pending status, deposit unpaid alert (darkened for AA on warning-bg)" },
      "warning-bg":   { "value": "#fef9c3", "desc": "Warning chip background" },
      "danger":       { "value": "#7f1d1d", "desc": "Cancelled, overdue, expired badge (darkened for AA on danger-bg)" },
      "danger-bg":    { "value": "#fee2e2", "desc": "Danger chip background" },
      "info":         { "value": "#0284c7", "desc": "Info alert (reservation modified)" },
      "info-bg":      { "value": "#e0f2fe", "desc": "Info chip background" },

      "active-rental": { "value": "#7c3aed", "desc": "Active/on-rent badge (observed: purple in calendar blocks)" }
    },

    "contrast_pairs": [
      { "fg": "text",         "bg": "surface",      "usage": "Body text on cards/tables",        "required": 4.5 },
      { "fg": "text",         "bg": "bg",           "usage": "Body text on page background",     "required": 4.5 },
      { "fg": "text-muted",   "bg": "surface",      "usage": "Helper text on cards",             "required": 4.5 },
      { "fg": "on-accent",    "bg": "accent",       "usage": "Button label on primary button",   "required": 4.5 },
      { "fg": "text-on-dark", "bg": "sidebar-bg",   "usage": "Nav items in sidebar",             "required": 4.5 },
      { "fg": "sidebar-text", "bg": "sidebar-bg",   "usage": "Muted nav items in sidebar",       "required": 4.5 },
      { "fg": "success",      "bg": "success-bg",   "usage": "Status badge text",                "required": 4.5 },
      { "fg": "warning",      "bg": "warning-bg",   "usage": "Warning badge text",               "required": 4.5 },
      { "fg": "danger",       "bg": "danger-bg",    "usage": "Danger badge text",                "required": 4.5 },
      { "fg": "border-input", "bg": "surface",      "usage": "Input border on white (3:1 UI)",   "required": 3.0 }
    ]
  },

  "typography": {
    "font_family": {
      "sans":  "Geist, ui-sans-serif, system-ui, -apple-system, sans-serif",
      "mono":  "Geist Mono, ui-monospace, monospace"
    },
    "scale": {
      "xs":   { "size": "0.75rem",  "line": "1rem",    "px": 12 },
      "sm":   { "size": "0.875rem", "line": "1.25rem", "px": 14 },
      "base": { "size": "1rem",     "line": "1.5rem",  "px": 16 },
      "lg":   { "size": "1.125rem", "line": "1.75rem", "px": 18 },
      "xl":   { "size": "1.25rem",  "line": "1.75rem", "px": 20 },
      "2xl":  { "size": "1.5rem",   "line": "2rem",    "px": 24 },
      "3xl":  { "size": "1.875rem", "line": "2.25rem", "px": 30 }
    },
    "weight": {
      "normal":   400,
      "medium":   500,
      "semibold": 600,
      "bold":     700
    },
    "usage": {
      "page-title":    { "size": "xl",   "weight": "semibold" },
      "section-title": { "size": "base", "weight": "semibold" },
      "table-header":  { "size": "xs",   "weight": "semibold", "transform": "uppercase", "tracking": "0.05em" },
      "table-cell":    { "size": "sm",   "weight": "normal" },
      "label":         { "size": "sm",   "weight": "medium" },
      "helper":        { "size": "xs",   "weight": "normal" },
      "button-sm":     { "size": "xs",   "weight": "semibold" },
      "button-md":     { "size": "sm",   "weight": "semibold" },
      "button-lg":     { "size": "base", "weight": "semibold" }
    }
  },

  "spacing": {
    "base": 4,
    "scale": {
      "0":  "0px",
      "1":  "4px",
      "2":  "8px",
      "3":  "12px",
      "4":  "16px",
      "5":  "20px",
      "6":  "24px",
      "8":  "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "20": "80px",
      "24": "96px"
    }
  },

  "radius": {
    "none": "0px",
    "sm":   "4px",
    "md":   "6px",
    "lg":   "8px",
    "xl":   "12px",
    "full": "9999px"
  },

  "shadow": {
    "none": "none",
    "sm":   "0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "md":   "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
    "lg":   "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
    "xl":   "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)"
  },

  "motion": {
    "duration": {
      "fast":   "100ms",
      "normal": "150ms",
      "slow":   "300ms"
    },
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "in":      "cubic-bezier(0.4, 0, 1, 1)",
      "out":     "cubic-bezier(0, 0, 0.2, 1)"
    }
  },

  "layout": {
    "sidebar_width":        "240px",
    "sidebar_collapsed":    "64px",
    "header_height":        "56px",
    "content_max_width":    "1400px",
    "content_padding":      "24px",
    "table_row_height":     "48px",
    "wizard_progress_height": "48px",
    "summary_panel_width":  "320px",
    "breakpoints": {
      "sm":  "640px",
      "md":  "768px",
      "lg":  "1024px",
      "xl":  "1280px",
      "2xl": "1536px"
    }
  }
}
